{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023"],
		"types": ["node"],
		"rootDir": "src",
		"outDir": "de.chrisliebaer.claude-voice.sdPlugin/bin",
		"strict": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"sourceMap": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}
